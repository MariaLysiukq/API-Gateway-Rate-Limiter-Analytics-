# Copy to .env and adjust. Hostnames match the services in docker-compose.yml.
PROJECT_NAME=API Gateway
ENVIRONMENT=development

POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=gateway_pass
POSTGRES_DB=gateway_db

DATABASE_URL=postgresql+asyncpg://gateway_user:gateway_pass@postgres:5432/gateway_db
REDIS_URL=redis://redis:6379/0

# Backend service that /api/v1/proxy/* forwards to
TARGET_SERVICE_URL=https://httpbin.org

# Token for the /api/v1/admin endpoints (X-Admin-Token header).
# Leave empty to disable the admin API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me
